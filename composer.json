{
    "name": "otp-id/otp-id-php",
    "description": "Official PHP SDK for the OTP.ID V3 API — multi-channel OTP delivery and verification (WhatsApp, SMS, Voice, Email, Missed Call, and WhatsApp Inbound) with prepaid billing.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "otp",
        "sms",
        "whatsapp",
        "verification",
        "2fa",
        "otp-id",
        "sdk"
    ],
    "homepage": "https://otp.id",
    "support": {
        "issues": "https://github.com/otp-id/otp-id-php/issues",
        "docs": "https://docs.otp.id",
        "source": "https://github.com/otp-id/otp-id-php"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "phpstan/phpstan": "^2",
        "friendsofphp/php-cs-fixer": "^3"
    },
    "autoload": {
        "psr-4": {
            "OtpId\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OtpId\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
